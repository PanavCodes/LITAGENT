# LLM Configuration
LLM_PROVIDER=google-genai  # options: google-genai, openai, anthropic, fake
ANSWER_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-pro

# API Keys (set the one matching LLM_PROVIDER)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAlex Etiquette (polite pool requires contact email)
OPENALEX_MAILTO=researcher@example.com

# Graph Database (Neo4j or NetworkX fallback)
GRAPH_BACKEND=networkx     # options: neo4j, networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=litagentpassword
